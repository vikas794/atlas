# Atlas environment variables
#
# Setup: copy this file to `.env` in the repository root, then fill in the keys marked
# REQUIRED. Everything else can stay empty: an EMPTY value means "use the default" (so a
# straight `cp .env.example .env` is valid). `.env` is gitignored and is loaded at startup by
# `load_settings()` (src/config/settings.py) WITHOUT overriding variables already set in your
# shell. Resolution order for every setting: ATLAS_<FIELD> > the unprefixed name listed below
# > src/configs/config.yaml > the built-in default.
#
# NEVER commit a real .env file. Every key below is empty on purpose.

# ------------------------------------------------------------------------------
# Keys (secrets)
# ------------------------------------------------------------------------------
# REQUIRED to ingest playlists: YouTube Data API v3 key (Google Cloud Console, enable
# "YouTube Data API v3"). Without it POST /api/playlists answers 503 CONFIG_MISSING.
YOUTUBE_API_KEY=
# REQUIRED when NOTES_PROVIDER=gemini (the default): Google AI Studio / Gemini API key.
GEMINI_API_KEY=
# REQUIRED when NOTES_PROVIDER=openrouter: OpenRouter API key.
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# AI notes generation
# ------------------------------------------------------------------------------
# Which provider generates the notes: gemini | openrouter (default: gemini).
NOTES_PROVIDER=
# Model override for note generation, for either provider. Empty -> provider default.
NOTES_MODEL=
# Gemini model id used when NOTES_MODEL is empty (default: gemini-2.5-flash).
GEMINI_MODEL=
# Maximum prompt (input) tokens accepted by the Gemini model (default: 1000000).
GEMINI_INPUT_TOKEN_LIMIT=
# OpenRouter model id used when NOTES_MODEL is empty (default: openai/gpt-5-mini).
OPENROUTER_MODEL=
# OpenAI-compatible OpenRouter endpoint (default: https://openrouter.ai/api/v1).
OPENROUTER_BASE_URL=
# Maximum prompt tokens accepted for OpenRouter models (default: 128000).
OPENROUTER_INPUT_TOKEN_LIMIT=
# Prompt file in src/prompts (default: notes_v1_1.yaml). The prompt version recorded with
# every summary is the `version` key inside that file, so it always matches its contents.
NOTES_PROMPT_NAME=

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
# SQLite database (default: data/atlas.sqlite3). It holds the only copy of transcripts and
# unreviewed edits: back it up by copying this file.
ATLAS_DATABASE_PATH=
# Where prompt templates live (default: src/prompts).
ATLAS_PROMPTS_BASE_DIR=
# DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO).
ATLAS_LOG_LEVEL=
# Also write logs to ATLAS_LOG_FILE (true | false, default: false).
ATLAS_LOG_FILE_LOGGING=
# Log file path (default: logs/atlas.log).
ATLAS_LOG_FILE=

# ------------------------------------------------------------------------------
# Transcripts
# ------------------------------------------------------------------------------
# Preferred transcript language code (default: en). If neither it nor English exists, the
# video's own subtitle language is used and recorded.
ATLAS_TRANSCRIPT_LANGUAGE=
# Directory the raw subtitle files are written to (default: transcripts).
ATLAS_TRANSCRIPT_OUTPUT_FOLDER=

# ------------------------------------------------------------------------------
# Google Drive (publishing)
# ------------------------------------------------------------------------------
# OAuth client credentials JSON downloaded from Google Cloud (default: credentials.json).
# In Docker use a path inside the writable ./secrets mount, e.g. /app/secrets/credentials.json.
ATLAS_GOOGLE_CREDS_PATH=
# Where the OAuth access/refresh token is cached (default: token.json). This file grants Drive
# access - never commit it. It is rewritten when the token refreshes, so it must be writable.
ATLAS_GOOGLE_TOKEN_PATH=
# Automatic retries of a transient Drive/Docs failure (429, 5xx, rate-limit 403, network).
ATLAS_DRIVE_MAX_RETRIES=
# First Drive backoff delay in seconds (default: 1.0) and its upper bound (default: 10.0).
ATLAS_DRIVE_BACKOFF_BASE_SECONDS=
ATLAS_DRIVE_BACKOFF_CAP_SECONDS=

# ------------------------------------------------------------------------------
# Pipeline
# ------------------------------------------------------------------------------
# How many videos are processed at once (default: 2).
ATLAS_MAX_CONCURRENT_VIDEOS=
# Automatic retries per video for a transient failure; the ONLY retry layer, so a video makes
# at most 1 + this many LLM calls (default: 4). Afterwards it is manual-retry only.
ATLAS_MAX_AUTO_RETRIES=
# First backoff delay in seconds; grows exponentially (default: 5.0).
ATLAS_BACKOFF_BASE_SECONDS=
# Upper bound on any single backoff delay in seconds (default: 300.0).
ATLAS_BACKOFF_CAP_SECONDS=
# How often the background worker looks for work when idle, in seconds (default: 2.0).
ATLAS_WORKER_POLL_INTERVAL_SECONDS=
# Grace period for running jobs on shutdown before they are cancelled (default: 5.0).
ATLAS_WORKER_SHUTDOWN_TIMEOUT_SECONDS=

# ------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------
# Comma-separated origins allowed to call the API, e.g. http://localhost:5173
ATLAS_CORS_ORIGINS=
