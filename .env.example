# Atlas secrets
#
# Setup: copy this file to `.env` in the repository root and fill in the keys below.
# `.env` is gitignored and is loaded at startup WITHOUT overriding variables already set in
# your shell. NEVER commit a real .env file. Every value here is empty on purpose.
#
# Everything that is not a secret (AI provider and model, concurrency, retries, database
# path, host, port, log level, ...) lives in ONE place: src/configs/config.yaml.
# A missing key does not stop Atlas from starting; the Diagnostics screen
# (GET /api/diagnostics) reports what is missing.

# REQUIRED to ingest playlists: YouTube Data API v3 key (Google Cloud Console, enable
# "YouTube Data API v3"). Without it POST /api/playlists answers 503 CONFIG_MISSING.
YOUTUBE_API_KEY=
# REQUIRED when notes_provider is gemini (the default): Google AI Studio / Gemini API key.
GEMINI_API_KEY=
# REQUIRED when notes_provider is openrouter: OpenRouter API key.
OPENROUTER_API_KEY=

# Google Drive publishing does not use a key here: upload the OAuth client file on the
# Settings page (or save it as credentials.json) and complete the consent flow once. The
# resulting token.json grants Drive access: never commit it (both files are gitignored).

# ------------------------------------------------------------------------------
# Optional: one-off overrides of config.yaml (prefer editing config.yaml)
# ------------------------------------------------------------------------------
# Any config.yaml setting can be overridden as ATLAS_<SETTING_IN_UPPERCASE>, for example:
#   ATLAS_PORT=8001
#   ATLAS_MAX_CONCURRENT_VIDEOS=3
#   ATLAS_DATABASE_PATH=D:/atlas-data/atlas.sqlite3
#   ATLAS_LOG_LEVEL=DEBUG
# The notes settings also accept the short names NOTES_PROVIDER, NOTES_MODEL,
# NOTES_PROMPT_NAME, GEMINI_MODEL, GEMINI_INPUT_TOKEN_LIMIT, OPENROUTER_MODEL,
# OPENROUTER_BASE_URL and OPENROUTER_INPUT_TOKEN_LIMIT. Empty values count as unset.
# An invalid value stops startup with a message naming it.
