# --- Secrets (never commit) ---------------------------------------------------
.env
.env.*
!.env.example
credentials.json
token.json
client_secret*.json
secrets/

# --- Local runtime data (repository root only; anchored so source folders named
#     data/, db/ or summaries/ are never silently ignored) ------------------------
/data/
/db/
/transcripts/
/summaries/
/pipeline_output/
/srt_files/
/logs/
/.runtime/
*.log
*.log.[0-9]*
*.sqlite3
*.sqlite3-*
*.db
*.bak

# --- Python ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
/build/
.eggs/
.venv/
venv/
ENV/
env/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
cython_debug/
.ipynb_checkpoints

# --- Tests and coverage -------------------------------------------------------------
.pytest_cache/
.pytest_tmp/
pytestdebug.log
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.hypothesis/
nosetests.xml
coverage.xml
*.cover

# --- Frontend -------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/coverage/

# --- Lock files (only the committed ones) ---------------------------------------------
*.lock
!uv.lock

# --- Editors / OS -------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*.tmp

# --- Local exports that should not be committed ------------------------------------
*.xlsx
*.pdf

# --- Tooling ---------------------------------------------------------------------------
